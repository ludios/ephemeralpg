#!/bin/sh
# Model-output: Claude Opus 5.5

case "$1" in
	-V)
		echo "pg_ctl (PostgreSQL) 16.3"
		exit 0
		;;
esac

# Print each argument with quotes if it would otherwise be split by a space
printf >&2 $(basename $0)
one_arg() { [ $# -eq 1 ]; }
while [ $# -gt 0 ]; do
	one_arg $1
	[ $? -eq 0 ] && printf >&2 " $1" || printf >&2 " \"$1\""
	shift
done
echo >&2
# Mimic a failure when the test asks for one
exit ${PG_CTL_EXIT:-0}
